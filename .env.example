# Database
DATABASE_URL=postgresql://groundops:groundops@postgres:5432/groundops
POSTGRES_USER=groundops
POSTGRES_PASSWORD=groundops
POSTGRES_DB=groundops

# Redis
REDIS_URL=redis://redis:6379/0

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FLIGHTAWARE_API_KEY=your_flightaware_api_key_here

# LLM Settings
LLM_MODEL=claude-sonnet-4-20250514

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_STORAGE_CONTAINER=ground-ops-data

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# FastAPI
HOST=0.0.0.0
PORT=8000

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Alerting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM_EMAIL=alerts@groundops.example.com

# Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# ML Model Settings
DELAY_PREDICTION_THRESHOLD=0.7
CONFIDENCE_INTERVAL=0.95
MODEL_REFRESH_INTERVAL_HOURS=24

# Airport Configuration
DEFAULT_AIRPORT_CODE=IST
TIMEZONE=Europe/Istanbul

# Ingestion Settings
AODB_API_URL=http://airport-aodb-api.example.com
AODB_API_KEY=your_aodb_api_key
HANDLER_API_URL=http://handler-api.example.com
HANDLER_API_KEY=your_handler_api_key
GPS_TRACKER_URL=http://gps-tracker.example.com
GPS_TRACKER_KEY=your_gps_tracker_key

# Logging
LOG_LEVEL=INFO
